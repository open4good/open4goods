{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open4goods.org/schema/resolution-rules-1.json",
  "title": "O4G resolution rules",
  "description": "Per-attribute, per-surface source ranking used to resolve conflicting evidence. There is deliberately no document-level default order: every rule must name its own attribute and surface.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": {"const": "https://open4goods.org/schema/resolution-rules-1.json"},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "surface", "version", "rankedSources"],
      "properties": {
        "attribute": {"type": "string", "pattern": "^o4g:attribute:[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "surface": {"enum": ["NUDGER_WEB", "B2B_API", "ODBL_EXPORT"]},
        "version": {"type": "string", "pattern": "^[a-z0-9]+(?:[.\\-][a-z0-9]+)*@[0-9]+$"},
        "rankedSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.\\-][a-z0-9]+)*$"}
        },
        "regulatoryAuthority": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[.\\-][a-z0-9]+)*$"}
      }
    }
  }
}
