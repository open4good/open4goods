{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open4goods.org/schema/model-pattern-rules-1.json",
  "title": "O4G reviewed family pattern rules",
  "description": "Git-authored, reviewed regex rules confirming a FAMILY group within one canonical brand and O4G class. Every rule here is, by construction, the reviewed branch of ADR-0010's family grouping; unreviewed common-prefix similarity is a separate, candidate-only mechanism never expressed through this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": {"const": "https://open4goods.org/schema/model-pattern-rules-1.json"},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "canonicalBrand", "canonicalClass", "pattern", "examples", "counterexamples", "reviewer"],
      "properties": {
        "version": {"type": "string", "pattern": "^[a-z0-9]+(?:[.\\-][a-z0-9]+)*@[0-9]+$"},
        "canonicalBrand": {"type": "string", "minLength": 1},
        "canonicalClass": {"type": "string", "pattern": "^o4g:class:[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "pattern": {"type": "string", "minLength": 1},
        "examples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "counterexamples": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reviewer": {"type": "string", "minLength": 1}
      }
    }
  }
}
