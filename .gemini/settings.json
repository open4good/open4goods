{
  "mcpServers": {
    "javalens": {
      "command": "bash",
      "args": [
        "scripts/mcp/javalens.sh"
      ]
    },
    "maven-deps": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-maven-deps@0.2.0"
      ]
    },
    "maven-tools": {
      "command": "bash",
      "args": [
        "scripts/mcp/maven-tools.sh"
      ]
    },
    "vuetify": {
      "command": "npx",
      "args": [
        "-y",
        "@vuetify/mcp@0.11.0"
      ]
    },
    "docker": {
      "command": "bash",
      "args": [
        "scripts/mcp/docker-readonly.sh"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.0.6"
      ]
    },
    "plausible": {
      "command": "npx",
      "args": [
        "-y",
        "@icjia/plausible-mcp@0.1.5"
      ],
      "env": {
        "PLAUSIBLE_BASE_URL": "https://plausible.nudger.fr",
        "PLAUSIBLE_DEFAULT_SITE": "nudger.fr",
        "PLAUSIBLE_API_KEY": "${PLAUSIBLE_API_KEY}"
      }
    }
  }
}
