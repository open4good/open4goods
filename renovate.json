{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Paris",
  "schedule": ["* 0-5 * * 1"],
  "updateNotScheduled": false,
  "prConcurrentLimit": 4,
  "branchConcurrentLimit": 4,
  "prCreation": "immediate",
  "ignorePaths": ["ui/**"],
  "automerge": false,
  "dependencyDashboard": true,
  "separateMultipleMajor": true,

  "major": {
    "automerge": false,
    "dependencyDashboardApproval": true
  },

  "vulnerabilityAlerts": {
    "automerge": false,
    "groupName": null
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"]
  },

  "packageRules": [
    {
      "description": "Keep major upgrades ungrouped and approved from the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "groupName": null
    },
    {
      "description": "Use npmInstallTwice only when updating frontend npm lock files",
      "matchFileNames": ["frontend/**", "b2b-frontend/**"],
      "matchManagers": ["npm"],
      "postUpdateOptions": ["npmInstallTwice"]
    },
    {
      "description": "Group non-major frontend npm updates",
      "matchFileNames": ["frontend/**", "b2b-frontend/**"],
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "replacement", "rollback", "bump"],
      "groupName": "frontend npm updates",
      "groupSlug": "frontend-npm-updates",
      "labels": ["squad:ux", "dependencies:npm"]
    },
    {
      "description": "Keep frontend lock-file maintenance in its own reviewable pull request",
      "matchFileNames": ["frontend/**", "b2b-frontend/**"],
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": "frontend lock file maintenance",
      "groupSlug": "frontend-lock-file-maintenance",
      "labels": ["squad:ux", "dependencies:npm", "maintenance:lockfile"]
    },
    {
      "description": "Group non-major backend Maven updates",
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "replacement", "rollback", "bump"],
      "groupName": "backend Maven updates",
      "groupSlug": "backend-maven-updates",
      "labels": ["squad:backend", "dependencies:maven"]
    },
    {
      "description": "Group non-major Python worker updates",
      "matchManagers": ["pep621", "pep723", "pip-compile", "pip_requirements", "pip_setup", "pipenv", "poetry", "setup-cfg"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "replacement", "rollback", "bump"],
      "groupName": "Python worker updates",
      "groupSlug": "python-worker-updates",
      "labels": ["squad:backend", "dependencies:python"]
    },
    {
      "description": "Group non-major Docker, Compose, and GitHub Actions updates",
      "matchManagers": ["dockerfile", "docker-compose", "github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "replacement", "rollback", "bump"],
      "groupName": "build and infrastructure updates",
      "groupSlug": "build-infrastructure-updates",
      "labels": ["squad:platform", "dependencies:infrastructure"]
    }
  ]
}
