# Copy to .env.local with scripts/local/open4goods.sh init. Never commit private values.
O4G_LOCAL_DATA_ROOT=./.local/data
O4G_LOCAL_CONFIG_DIR=./.local/config
PRODUCT_BACKUP_SOURCE_URI=./.local/backup
XWIKI_XAR_PATH=./.local/backup/xwiki-backup.xar

O4G_LOCAL_POSTGRES_DB=product_data_api
O4G_LOCAL_POSTGRES_USER=product_data_api
O4G_LOCAL_POSTGRES_PASSWORD=open4goods-local
O4G_LOCAL_XWIKI_DB_PASSWORD=open4goods-local
O4G_LOCAL_XWIKI_ROOT_PASSWORD=open4goods-local-root

# Local applications share these values; replace them in .env.local.
FRONT_SECURITY_SHARED_TOKEN=CHANGE_ME_SHARED_TOKEN
FRONT_SECURITY_JWT_SECRET=CHANGE_ME_TO_A_LONG_SECRET_VALUE_32_BYTES_MIN
B2B_JWT_SECRET=change-me-dev-only-change-me-dev-only
O4G_LOCAL_ADMIN_KEY=open4goods-local-admin
FRONT_CONTACT_EMAIL=local@example.invalid

# Optional live connectors. Values stay empty until an explicit operator-run job needs them.
OPENAI_API_KEY=
GEMINI_API_KEY=
FEEDBACK_GITHUB_ACCESS_TOKEN=
GOOGLE_INDEXATION_SERVICE_ACCOUNT_PATH=
SPRING_MAIL_PASSWORD=
STRIPE_SECRET_KEY=
O4G_LOCAL_FULL_IMPORT_URL=
