# Shared-build-host profile: `cp .env.buildhost.example .env.local`, then edit
# the CHANGE_ME values. Never commit private values.
# See docs/operations/buildhost-runtime.md for the contract this port and
# storage plan implements. Set O4G_SHARED_HOST=1 when invoking
# scripts/local/open4goods.sh so `up`/`restart`/`data full` run the preflight
# gate below, which independently verifies none of this collides with
# whatever else is already bound on the host.
O4G_PORT_API=4100
O4G_PORT_UI=4101
O4G_PORT_ADMIN=4102
O4G_PORT_FRONT_API=4103
O4G_PORT_B2B_API=4104
O4G_PORT_EXPOSED_DOCS=4105
O4G_PORT_GEOCODE=4106
O4G_PORT_FRONTEND=4107
O4G_PORT_B2B_FRONTEND=4108
# 4109 stays reserved (spare in the assigned block).

# Infra containers are not opened by the QA browser, so they sit just above
# the assigned app block on the same loopback interface.
O4G_PORT_ELASTICSEARCH=4150
O4G_PORT_REDIS=4151
O4G_PORT_POSTGRES=4152
O4G_PORT_KIBANA=4153
O4G_PORT_XWIKI=4154

# Point these at a dedicated, writable directory this agent controls and that
# preflight can verify against O4G_SHARED_HOST_APPROVED_ROOTS below -- never a
# host-shared path this account was not explicitly granted access to.
# Replace GOU-REPLACE with this issue's identifier before running preflight.
# Docker-created files must remain outside the disposable Git worktree.
O4G_LOCAL_DATA_ROOT=${HOME}/.local/share/open4goods/GOU-REPLACE/data
O4G_LOCAL_CONFIG_DIR=./.local/config

# Read-only backup access is a stated acceptance target but is NOT available
# by default: it requires an operator-granted, host-level prerequisite this
# profile cannot self-provision. Until granted, this stays local-only and
# empty; see docs/operations/buildhost-runtime.md.
PRODUCT_BACKUP_SOURCE_URI=./.local/backup
XWIKI_XAR_PATH=./.local/backup/xwiki-backup.xar

O4G_LOCAL_POSTGRES_DB=product_data_api
O4G_LOCAL_POSTGRES_USER=product_data_api
O4G_LOCAL_POSTGRES_PASSWORD=CHANGE_ME
O4G_LOCAL_XWIKI_DB_PASSWORD=CHANGE_ME
O4G_LOCAL_XWIKI_ROOT_PASSWORD=CHANGE_ME

FRONT_SECURITY_SHARED_TOKEN=CHANGE_ME_SHARED_TOKEN
FRONT_SECURITY_JWT_SECRET=CHANGE_ME_TO_A_LONG_SECRET_VALUE_32_BYTES_MIN
B2B_JWT_SECRET=CHANGE_ME_DEV_ONLY
O4G_LOCAL_ADMIN_KEY=CHANGE_ME
FRONT_CONTACT_EMAIL=local@example.invalid

# Optional live connectors. Values stay empty until an explicit operator-run
# job needs them; no heavy connector or ingestion job starts with the stack.
OPENAI_API_KEY=
GEMINI_API_KEY=
FEEDBACK_GITHUB_ACCESS_TOKEN=
GOOGLE_INDEXATION_SERVICE_ACCOUNT_PATH=
SPRING_MAIL_PASSWORD=
STRIPE_SECRET_KEY=
# Full import stays disabled until the read-only backup prerequisite above is
# granted and a loopback importer URL is pinned; open4goods.sh still refuses
# anything but a loopback URL, gates it behind the stricter full-import
# preflight floor, and serializes the run with a flock.
O4G_LOCAL_FULL_IMPORT_URL=

# Shared-host preflight budget (see docs/operations/buildhost-runtime.md).
O4G_SHARED_HOST_PORT_MIN=4100
O4G_SHARED_HOST_PORT_MAX=4109
O4G_SHARED_HOST_INFRA_PORT_MIN=4150
O4G_SHARED_HOST_INFRA_PORT_MAX=4159
O4G_SHARED_HOST_MIN_FREE_GIB=20
O4G_SHARED_HOST_MIN_FREE_GIB_FULL_IMPORT=60
O4G_SHARED_HOST_MIN_MEM_GIB=8
O4G_SHARED_HOST_MIN_CPU=2
O4G_SHARED_HOST_MIN_PIDS=512
# Colon-separated allow-list data/config/backup paths must resolve inside
# (symlinks included); defaults to .local plus a per-user persistent store.
# O4G_SHARED_HOST_APPROVED_ROOTS=./.local:${HOME}/.local/share/open4goods
# Dedicated per-user lock directory outside any worktree; defaults to
# ${XDG_STATE_HOME:-$HOME/.local/state}/open4goods-shared-host.
# O4G_SHARED_HOST_LOCK_DIR=
