# Shared-build-host profile: `cp .env.buildhost.example .env.local`, then edit
# the CHANGE_ME values. Never commit private values.
# See docs/operations/buildhost-runtime.md for the isolation/capacity report
# this port and storage plan is derived from. Set O4G_SHARED_HOST=1 when
# invoking scripts/local/open4goods.sh so `up` runs the preflight gate below.

# Every app port stays inside the QA-reachable loopback block the build host
# assigns this agent (127.0.0.1:4100-4109); nothing here may collide with the
# beta/prod ports already bound on the shared host (3000, 3001, 5432, 5601,
# 6379, 8080-8092, 9200, ...).
O4G_PORT_API=4100
O4G_PORT_UI=4101
O4G_PORT_ADMIN=4102
O4G_PORT_FRONT_API=4103
O4G_PORT_B2B_API=4104
O4G_PORT_EXPOSED_DOCS=4105
O4G_PORT_GEOCODE=4106
O4G_PORT_FRONTEND=4107
O4G_PORT_B2B_FRONTEND=4108
# 4109 stays reserved (spare in the assigned block).

# Infra containers are not opened by the QA browser, so they sit just above
# the assigned app block on the same loopback interface, still clear of every
# beta/prod port observed on the host.
O4G_PORT_ELASTICSEARCH=4150
O4G_PORT_REDIS=4151
O4G_PORT_POSTGRES=4152
O4G_PORT_KIBANA=4153
O4G_PORT_XWIKI=4154

# The shared host root filesystem runs at ~86% used (see the capacity
# report); keep the persistent rootless store off it. Point this at a
# dedicated, writable directory this agent controls -- NOT /diskb, which is
# root/open4goods-group owned and not writable by this account (see the
# report's "prerequisites" section).
O4G_LOCAL_DATA_ROOT=./.local/data
O4G_LOCAL_CONFIG_DIR=./.local/config

# Read-only backup access is a stated acceptance target but is NOT available
# yet: /diskb/open4goods-api-product-backup and /diskb/open4goods-backup are
# root:root / open4goods:open4goods 750 and this account has no ACL entry and
# no open4goods group membership. `data sample` and `data full` cannot run
# against the real backup until an operator grants
# `setfacl -R -m u:paperclip:rX /diskb/open4goods-api-product-backup` (or
# equivalent group membership) -- see docs/operations/buildhost-runtime.md.
# Until then this stays local-only and empty.
PRODUCT_BACKUP_SOURCE_URI=./.local/backup
XWIKI_XAR_PATH=./.local/backup/xwiki-backup.xar

O4G_LOCAL_POSTGRES_DB=product_data_api
O4G_LOCAL_POSTGRES_USER=product_data_api
O4G_LOCAL_POSTGRES_PASSWORD=CHANGE_ME
O4G_LOCAL_XWIKI_DB_PASSWORD=CHANGE_ME
O4G_LOCAL_XWIKI_ROOT_PASSWORD=CHANGE_ME

FRONT_SECURITY_SHARED_TOKEN=CHANGE_ME_SHARED_TOKEN
FRONT_SECURITY_JWT_SECRET=CHANGE_ME_TO_A_LONG_SECRET_VALUE_32_BYTES_MIN
B2B_JWT_SECRET=CHANGE_ME_DEV_ONLY
O4G_LOCAL_ADMIN_KEY=CHANGE_ME
FRONT_CONTACT_EMAIL=local@example.invalid

# Optional live connectors. Values stay empty until an explicit operator-run
# job needs them; no heavy connector or ingestion job starts with the stack.
OPENAI_API_KEY=
GEMINI_API_KEY=
FEEDBACK_GITHUB_ACCESS_TOKEN=
GOOGLE_INDEXATION_SERVICE_ACCOUNT_PATH=
SPRING_MAIL_PASSWORD=
STRIPE_SECRET_KEY=
# Full import stays disabled until the read-only backup prerequisite above is
# granted and a loopback importer URL is pinned; open4goods.sh still refuses
# anything but a loopback URL and serializes the run with a flock.
O4G_LOCAL_FULL_IMPORT_URL=

# Shared-host preflight budget (see docs/operations/buildhost-runtime.md);
# defaults match the measured user-slice allocation and are safe to leave.
O4G_SHARED_HOST_PORT_MIN=4100
O4G_SHARED_HOST_PORT_MAX=4109
O4G_SHARED_HOST_MIN_FREE_GIB=20
O4G_SHARED_HOST_MIN_MEM_GIB=8
O4G_SHARED_HOST_MIN_CPU=2
O4G_SHARED_HOST_MIN_PIDS=512
