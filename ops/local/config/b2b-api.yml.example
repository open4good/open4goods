server:
  port: 8087
spring:
  datasource:
    url: jdbc:postgresql://localhost:${O4G_PORT_POSTGRES:5432}/product_data_api
    username: ${O4G_LOCAL_POSTGRES_USER:product_data_api}
    password: ${O4G_LOCAL_POSTGRES_PASSWORD:open4goods-local}
  data:
    redis:
      host: localhost
      port: ${O4G_PORT_REDIS:6379}
  elasticsearch:
    uris: http://localhost:${O4G_PORT_ELASTICSEARCH:9200}
open4goods:
  scheduling:
    enabled: false
b2b:
  public-base-url: http://localhost:${O4G_PORT_B2B_FRONTEND:3001}
  security:
    allowed-origins: http://localhost:${O4G_PORT_B2B_FRONTEND:3001}
    cookie-domain:
    cookie-secure: false
