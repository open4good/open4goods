[Unit]
Description=open4goods %i service
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/open4goods/.cached
ConditionPathIsMountPoint=/opt/open4goods/.cached

[Service]
Type=simple
User=open4goods
Group=open4goods
EnvironmentFile=/etc/open4goods/%i.env
EnvironmentFile=-/etc/open4goods/infra.env
WorkingDirectory=/srv/open4goods/services/%i/current
ExecStart=/usr/bin/java $O4G_JAVA_OPTS -jar /srv/open4goods/services/%i/current/%i.jar
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/open4goods /var/log/open4goods /opt/open4goods/.cached /opt/open4goods/backup

[Install]
WantedBy=open4goods.target
